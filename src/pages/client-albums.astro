---
import Layout from '../layouts/Layout.astro'
import { Heart } from 'lucide-astro'
import { getAllAlbums, urlFor } from '../lib/sanity.ts'
import PageTransition from '../components/PageTransition.tsx'
import ScrollAnimation from '../components/ScrollAnimation.tsx'
import AnimatedContainer from '../components/AnimatedContainer.tsx'
import AlbumCard from '../components/AlbumCard.tsx'

// Fetch albums from Sanity
const albums = await getAllAlbums()

// Helper function to get cover image URL from Sanity
function getCoverImageUrl(coverImage: any): string | null {
  if (!coverImage) return null
  return urlFor(coverImage).width(400).height(300).fit('crop').format('webp').url()
}

// Helper function to format date
function formatDate(dateString: string | null | undefined): string {
  if (!dateString) return ''

  try {
    const date = new Date(dateString)
    if (!isNaN(date.getTime())) {
      return date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    }
  } catch {}

  return dateString
}

// Helper function to get readable album type
function getAlbumTypeDisplay(albumType: string): string {
  const types: Record<string, string> = {
    wedding: 'Wedding Photography',
    engagement: 'Engagement Session',
    bridal: 'Bridal Session',
    family: 'Family Portrait',
    maternity: 'Maternity Session',
    event: 'Special Event',
    graduation: 'Graduation',
    portrait: 'Portrait Session'
  }
  return types[albumType] || 'Portrait Session'
}
---

<Layout
  title="Client Albums - Rebecca Richards Photography"
  description="View beautiful wedding and engagement photo albums captured by Rebecca Richards Photography in Pennsylvania and surrounding areas."
>
  <PageTransition client:load>
    <!-- Albums Hero -->
    <section class="py-20 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <AnimatedContainer client:load animation="fadeIn">
          <h1 class="text-5xl md:text-6xl font-light text-gray-900 mb-6 tracking-wide">
            Client Albums
          </h1>
        </AnimatedContainer>

        <AnimatedContainer client:load animation="slideUp" delay={0.3}>
          <p class="text-xl md:text-2xl text-gray-600 leading-relaxed font-light mb-4">
            My heart is the lens of my camera
          </p>
          <p class="text-lg text-gray-500 font-light">See what I see</p>
        </AnimatedContainer>
      </div>
    </section>

  <!-- Albums Grid -->
  <section class="py-12 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {
        albums.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {albums.map((album, index) => {
              const coverImageUrl = getCoverImageUrl(album.coverImage)
              const albumTypeDisplay = getAlbumTypeDisplay(album.albumType)
              const formattedDate = formatDate(album.date)

              return (
                <div
                  class="animate-item"
                  style={`animation-delay: ${0.2 + (index * 0.15)}s`}
                >
                  <AlbumCard
                    client:load
                    album={album}
                    coverImageUrl={coverImageUrl}
                    albumTypeDisplay={albumTypeDisplay}
                    formattedDate={formattedDate}
                  />
                </div>
              )
            })}
          </div>
        ) : (
          <div class="text-center py-12">
            <Heart size={64} class="mx-auto text-gray-300 mb-4" />
            <h3 class="text-xl font-light text-gray-600 mb-2">Albums Coming Soon</h3>
            <p class="text-gray-500 font-light">
              New client albums are being added regularly. Check back soon!
            </p>
          </div>
        )
      }
    </div>
  </section>

    <!-- Call to Action -->
    <section class="py-20 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <ScrollAnimation client:load animation="fadeIn">
          <h2 class="text-4xl md:text-5xl font-light text-gray-900 mb-8 tracking-wide">
            Ready to Create Your Album?
          </h2>
          <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-12 font-light">
            Let's capture your special moments and create beautiful memories together.
          </p>
        </ScrollAnimation>

        <ScrollAnimation client:load animation="slideUp" delay={0.2}>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/contact"
              class="bg-rose-400 hover:bg-rose-500 text-white px-8 py-4 rounded-sm transition-colors duration-200 font-light tracking-wide hover-lift"
            >
              Book Your Session
            </a>
            <a
              href="/services"
              class="border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-sm hover:border-gray-400 transition-colors duration-200 font-light tracking-wide hover-scale"
            >
              View Packages
            </a>
          </div>
        </ScrollAnimation>
      </div>
    </section>
  </PageTransition>

  <style>
    .animate-item {
      opacity: 0;
      transform: translateY(50px) scale(0.95);
      animation: slideUpFade 0.6s ease-out forwards;
    }

    @keyframes slideUpFade {
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
  </style>
</Layout>
