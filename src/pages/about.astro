---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'
import { GraduationCap, Heart, Camera, Award, MapPin, Map, Plane, Instagram } from 'lucide-astro'
import PageTransition from '../components/PageTransition.tsx'
import ScrollAnimation from '../components/ScrollAnimation.tsx'
import AnimatedContainer from '../components/AnimatedContainer.tsx'

// Import images
import aboutImage from '../assets/about.jpg'
import beyondCameraImage from '../assets/beyond-the-camera.jpg'
---

<Layout
  title="About - Rebecca Richards Photography"
  description="Learn about Rebecca Richards, professional wedding photographer based in Doylestown, PA. Eastern University graduate specializing in wedding and engagement photography."
  pageType="about"
>
  <PageTransition client:load>
    <!-- About Hero -->
  <section class="py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- About Image -->
        <AnimatedContainer client:load animation="slideRight" delay={0.2} className="order-2 lg:order-1">
          <div class="aspect-square rounded-sm overflow-hidden hover-lift">
            <Image
              src={aboutImage}
              alt="Rebecca Richards, Professional Wedding Photographer"
              class="w-full h-full object-cover"
              width={600}
              height={600}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 600px"
              widths={[300, 600, 900, 1200]}
              formats={['avif', 'webp']}
            />
          </div>
        </AnimatedContainer>

        <!-- About Content -->
        <div class="order-1 lg:order-2">
          <AnimatedContainer client:load animation="fadeIn" className="mb-8">
            <h1 class="text-5xl md:text-6xl font-light text-gray-900 tracking-wide">
              Hi, I'm Rebecca
            </h1>
          </AnimatedContainer>

          <AnimatedContainer client:load animation="slideUp" delay={0.3}>
            <div class="space-y-6 text-lg text-gray-600 font-light leading-relaxed">
            <p>
              My name is Rebecca Richards, and my passion in life is to create the most memorable
              and beautiful moments through photography. I believe in the value of capturing
              authentic emotions and genuine connections that tell your unique story.
            </p>
            <p>
              Based in Doylestown, PA, I specialize in wedding photography, but my heart extends to
              engagement sessions and special family celebrations. Every love story is different,
              and I'm here to document yours with artistry and care.
            </p>
            <p>
              When I'm not behind my camera, you'll find me pursuing fashion design studies,
              collaborating on event planning with <a
                href="https://www.arielashtonevents.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-rose-400 hover:text-rose-500 transition-colors duration-200 underline decoration-rose-300 hover:decoration-rose-400"
              >Ariel Ashton Events</a>, and writing. These diverse
              interests inform my creative approach and help me bring a unique perspective to every
              shoot.
            </p>

            <!-- Social Media Links -->
            <div class="flex gap-6 pt-4">
              <a
                href="https://instagram.com/rebeccarichardsphotography_"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-rose-400 hover:text-rose-500 transition-colors duration-200 font-light tracking-wide hover-scale"
                aria-label="Rebecca Richards Events on Instagram"
              >
                <Instagram size={20} />
                @rebeccarichardsphotography_
              </a>
              <a
                href="https://www.instagram.com/rebecccarichards/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-rose-400 hover:text-rose-500 transition-colors duration-200 font-light tracking-wide hover-scale"
                aria-label="Rebecca Richards Personal Instagram"
              >
                <Instagram size={20} />
                @rebecccarichards
              </a>
            </div>
            </div>
          </AnimatedContainer>
        </div>
      </div>
    </div>
  </section>

  <!-- Education & Experience -->
  <section class="py-20 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ScrollAnimation client:load animation="fadeIn" className="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-light text-gray-900 mb-8 tracking-wide">
          Background & Expertise
        </h2>
        <p class="text-lg text-gray-600 font-light max-w-2xl mx-auto">
          Combining formal education with creative passion to deliver exceptional results
        </p>
      </ScrollAnimation>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Education -->
        <ScrollAnimation client:load animation="slideUp" delay={0} className="text-center">
          <div class="w-16 h-16 bg-rose-100 rounded-full flex items-center justify-center mx-auto mb-6 hover-scale">
            <GraduationCap size={32} class="text-rose-400" />
          </div>
          <h3 class="text-xl font-light text-gray-900 mb-4 tracking-wide">Education</h3>
          <p class="text-gray-600 font-light leading-relaxed">
            Bachelor of Science in Marketing and Spanish from Eastern University (2021)
          </p>
        </ScrollAnimation>

        <!-- Photography -->
        <ScrollAnimation client:load animation="slideUp" delay={0.1} className="text-center">
          <div class="w-16 h-16 bg-rose-100 rounded-full flex items-center justify-center mx-auto mb-6 hover-scale">
            <Camera size={32} class="text-rose-400" />
          </div>
          <h3 class="text-xl font-light text-gray-900 mb-4 tracking-wide">Photography</h3>
          <p class="text-gray-600 font-light leading-relaxed">
            Specializing in wedding and engagement photography with a natural, authentic style
          </p>
        </ScrollAnimation>

        <!-- Event Planning -->
        <ScrollAnimation client:load animation="slideUp" delay={0.2} className="text-center">
          <div class="w-16 h-16 bg-rose-100 rounded-full flex items-center justify-center mx-auto mb-6 hover-scale">
            <Heart size={32} class="text-rose-400" />
          </div>
          <h3 class="text-xl font-light text-gray-900 mb-4 tracking-wide">Event Collaboration</h3>
          <p class="text-gray-600 font-light leading-relaxed">
            Working with <a
              href="https://www.arielashtonevents.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-rose-400 hover:text-rose-500 transition-colors duration-200 underline decoration-rose-300 hover:decoration-rose-400"
            >Ariel Ashton Events</a> brings additional event planning expertise
          </p>
        </ScrollAnimation>

        <!-- Creative Studies -->
        <ScrollAnimation client:load animation="slideUp" delay={0.3} className="text-center">
          <div class="w-16 h-16 bg-rose-100 rounded-full flex items-center justify-center mx-auto mb-6 hover-scale">
            <Award size={32} class="text-rose-400" />
          </div>
          <h3 class="text-xl font-light text-gray-900 mb-4 tracking-wide">Creative Arts</h3>
          <p class="text-gray-600 font-light leading-relaxed">
            Pursuing fashion design and writing to enhance artistic vision and storytelling
          </p>
        </ScrollAnimation>
      </div>
    </div>
  </section>

  <!-- Photography Philosophy -->
  <section class="py-20 bg-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <ScrollAnimation client:load animation="fadeIn">
        <h2 class="text-4xl md:text-5xl font-light text-gray-900 mb-12 tracking-wide">
          My Photography Philosophy
        </h2>
      </ScrollAnimation>

      <ScrollAnimation client:load animation="slideUp" delay={0.2}>
        <div class="space-y-8 text-lg text-gray-600 font-light leading-relaxed">
        <p>
          I believe that the best photographs happen when you forget the camera is there. My
          approach is to blend into your celebration, capturing genuine moments of joy, laughter,
          tears, and love as they naturally unfold.
        </p>
        <p>
          Every couple has a unique story, and my goal is to document yours in a way that feels
          authentic to who you are. Whether it's a quiet moment during getting ready or the
          explosive joy of your first dance, I'm there to preserve these memories for generations to
          come.
        </p>
        <p>
          With a background in marketing, I bring a strategic eye to composition and storytelling,
          ensuring that your wedding gallery tells a complete and beautiful narrative of your day.
        </p>
        </div>
      </ScrollAnimation>
    </div>
  </section>

  <!-- Personal Touch -->
  <section class="py-20 bg-rose-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Personal Image -->
        <ScrollAnimation client:load animation="slideLeft" className="order-2 lg:order-1">
          <div class="aspect-[4/3] rounded-sm overflow-hidden hover-lift">
            <Image
              src={beyondCameraImage}
              alt="Wedding photography example by Rebecca Richards"
              class="w-full h-full object-cover"
              width={600}
              height={450}
              loading="lazy"
              decoding="async"
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 600px"
              widths={[300, 600, 900, 1200]}
              formats={['avif', 'webp']}
            />
          </div>
        </ScrollAnimation>

        <!-- Personal Content -->
        <div class="order-1 lg:order-2">
          <ScrollAnimation client:load animation="fadeIn">
            <h2 class="text-4xl md:text-5xl font-light text-gray-900 mb-8 tracking-wide">
              Beyond the Camera
            </h2>
          </ScrollAnimation>

          <ScrollAnimation client:load animation="slideUp" delay={0.2}>
            <div class="space-y-6 text-lg text-gray-600 font-light leading-relaxed">
            <p>
              When I'm not photographing love stories, I'm usually creating in other ways. My
              studies in fashion design have given me an eye for detail, color, and composition that
              directly enhances my photography work.
            </p>
            <p>
              Working alongside <a
                href="https://www.arielashtonevents.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-rose-400 hover:text-rose-500 transition-colors duration-200 underline decoration-rose-300 hover:decoration-rose-400"
              >Ariel Ashton Events</a> has deepened my understanding of wedding
              timelines, logistics, and the intricate details that make each celebration special.
              This experience helps me anticipate moments and work seamlessly with your planning
              team.
            </p>
            <p>
              I'm also passionate about writing, which helps me connect with couples and understand
              their stories on a deeper level. It would be my honor to get to know you and see how I
              can capture memories that you'll treasure forever.
            </p>
            </div>
          </ScrollAnimation>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-20 bg-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <ScrollAnimation client:load animation="fadeIn">
        <h2 class="text-4xl md:text-5xl font-light text-gray-900 mb-12 tracking-wide">
          Where I Photograph
        </h2>
      </ScrollAnimation>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <ScrollAnimation client:load animation="slideUp" delay={0}>
          <div class="text-center">
            <div class="w-16 h-16 bg-rose-100 rounded-full flex items-center justify-center mx-auto mb-6 hover-scale">
              <MapPin size={32} class="text-rose-400" />
            </div>
            <h3 class="text-xl font-light text-gray-900 mb-4 tracking-wide">Primary Area</h3>
            <p class="text-gray-600 font-light leading-relaxed">
              Doylestown, Bucks County, and surrounding areas in Pennsylvania
            </p>
          </div>
        </ScrollAnimation>

        <ScrollAnimation client:load animation="slideUp" delay={0.1}>
          <div class="text-center">
            <div class="w-16 h-16 bg-rose-100 rounded-full flex items-center justify-center mx-auto mb-6 hover-scale">
              <Map size={32} class="text-rose-400" />
            </div>
            <h3 class="text-xl font-light text-gray-900 mb-4 tracking-wide">Extended Region</h3>
            <p class="text-gray-600 font-light leading-relaxed">
              Philadelphia, Montgomery County, Chester County, and parts of New Jersey
            </p>
          </div>
        </ScrollAnimation>

        <ScrollAnimation client:load animation="slideUp" delay={0.2}>
          <div class="text-center">
            <div class="w-16 h-16 bg-rose-100 rounded-full flex items-center justify-center mx-auto mb-6 hover-scale">
              <Plane size={32} class="text-rose-400" />
            </div>
            <h3 class="text-xl font-light text-gray-900 mb-4 tracking-wide">Destination</h3>
            <p class="text-gray-600 font-light leading-relaxed">
              Available for destination weddings throughout the Mid-Atlantic region
            </p>
          </div>
        </ScrollAnimation>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-20 bg-rose-50">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <ScrollAnimation client:load animation="fadeIn">
        <h2 class="text-4xl md:text-5xl font-light text-gray-900 mb-8 tracking-wide">
          Let's Connect
        </h2>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-12 font-light">
          I'd love to hear about your vision and learn more about your love story. Let's discuss how
          we can create something beautiful together.
        </p>
      </ScrollAnimation>

      <ScrollAnimation client:load animation="slideUp" delay={0.2}>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="bg-rose-400 hover:bg-rose-500 text-white px-8 py-4 rounded-sm transition-colors duration-200 font-light tracking-wide hover-lift"
          >
            Get in Touch
          </a>
          <a
            href="/client-albums"
            class="border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-sm hover:border-gray-400 transition-colors duration-200 font-light tracking-wide hover-scale"
          >
            View Client Albums
          </a>
        </div>
      </ScrollAnimation>
    </div>
  </section>
  </PageTransition>
</Layout>
