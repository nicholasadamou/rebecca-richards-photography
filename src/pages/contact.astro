---
import Layout from '../layouts/Layout.astro'
import { Mail, Phone, MapPin, Clock, Send } from 'lucide-astro'
import PageTransition from '../components/PageTransition.tsx'
import ScrollAnimation from '../components/ScrollAnimation.tsx'
import AnimatedContainer from '../components/AnimatedContainer.tsx'
---

<Layout
  title="Contact - Rebecca Richards Photography"
  description="Get in touch with Rebecca Richards Photography to discuss your wedding, engagement, or special event photography needs in Doylestown, PA."
  pageType="contact"
>
  <PageTransition client:load>
    <!-- Contact Hero -->
    <section class="py-20 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <AnimatedContainer client:load animation="fadeIn">
          <h1 class="text-5xl md:text-6xl font-light text-gray-900 mb-6 tracking-wide">
            Let's Connect
          </h1>
        </AnimatedContainer>

        <AnimatedContainer client:load animation="slideUp" delay={0.3}>
          <p class="text-xl md:text-2xl text-gray-600 leading-relaxed font-light">
            I'd love to hear about your love story and discuss how we can capture your special moments
          </p>
        </AnimatedContainer>
      </div>
    </section>

  <!-- Contact Content -->
  <section class="py-12 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Form -->
        <ScrollAnimation client:load animation="slideRight">
          <div class="bg-white rounded-lg shadow-sm p-8 hover-lift">
            <h2 class="text-3xl font-light text-gray-900 mb-8 tracking-wide">Send Me a Message</h2>

          <form class="space-y-6" id="contact-form" action="https://formspree.io/f/xrbygaga" method="POST">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="first-name" class="block text-sm font-light text-gray-700 mb-2">
                  First Name *
                </label>
                <input
                  type="text"
                  id="first-name"
                  name="firstName"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent transition-colors duration-200"
                />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-light text-gray-700 mb-2">
                  Last Name *
                </label>
                <input
                  type="text"
                  id="last-name"
                  name="lastName"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent transition-colors duration-200"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-light text-gray-700 mb-2">
                Email Address *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-gray-200 rounded-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent transition-colors duration-200"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-light text-gray-700 mb-2">
                Phone Number
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full px-4 py-3 border border-gray-200 rounded-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent transition-colors duration-200"
              />
            </div>

            <div>
              <label for="event-type" class="block text-sm font-light text-gray-700 mb-2">
                Type of Event *
              </label>
              <select
                id="event-type"
                name="eventType"
                required
                class="w-full px-4 py-3 border border-gray-200 rounded-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent transition-colors duration-200"
              >
                <option value="">Select an option</option>
                <option value="wedding">Wedding Photography</option>
                <option value="engagement">Engagement Session</option>
                <option value="special-event">Special Event</option>
                <option value="family">Family Portraits</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="event-date" class="block text-sm font-light text-gray-700 mb-2">
                  Event Date
                </label>
                <input
                  type="date"
                  id="event-date"
                  name="eventDate"
                  class="w-full px-4 py-3 border border-gray-200 rounded-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent transition-colors duration-200"
                />
              </div>
              <div>
                <label for="location" class="block text-sm font-light text-gray-700 mb-2">
                  Event Location
                </label>
                <input
                  type="text"
                  id="location"
                  name="location"
                  placeholder="City, State"
                  class="w-full px-4 py-3 border border-gray-200 rounded-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent transition-colors duration-200"
                />
              </div>
            </div>

            <div>
              <label for="budget" class="block text-sm font-light text-gray-700 mb-2">
                Photography Budget
              </label>
              <select
                id="budget"
                name="budget"
                class="w-full px-4 py-3 border border-gray-200 rounded-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent transition-colors duration-200"
              >
                <option value="">Select a range</option>
                <option value="under-2000">Under $2,000</option>
                <option value="2000-3500">$2,000 - $3,500</option>
                <option value="3500-5000">$3,500 - $5,000</option>
                <option value="5000-plus">$5,000+</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-light text-gray-700 mb-2">
                Tell Me About Your Vision *
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                placeholder="Share details about your event, style preferences, must-have shots, and anything else you'd like me to know..."
                class="w-full px-4 py-3 border border-gray-200 rounded-sm focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent transition-colors duration-200 resize-vertical"
              ></textarea>
            </div>

              <button
                type="submit"
                class="w-full cursor-pointer bg-rose-400 hover:bg-rose-500 text-white py-4 rounded-sm transition-colors duration-200 font-light tracking-wide flex items-center justify-center space-x-2 hover-lift"
              >
                <Send size={20} />
                <span>Send Message</span>
              </button>
            </form>

            <p class="mt-4 text-sm text-gray-600 font-light">
              * Required fields. I typically respond within 24 hours.
            </p>
          </div>
        </ScrollAnimation>

        <!-- Contact Information -->
        <ScrollAnimation client:load animation="slideLeft" className="space-y-8">
          <!-- Contact Details -->
          <div class="bg-white rounded-lg shadow-sm p-8">
            <h3 class="text-2xl font-light text-gray-900 mb-6 tracking-wide">
              Contact Information
            </h3>

            <div class="space-y-6">
              <div class="flex items-start space-x-4">
                <Mail size={24} class="text-rose-400 flex-shrink-0 mt-1" />
                <div>
                  <h4 class="font-light text-gray-900 mb-1">Email</h4>
                  <a
                    href="mailto:rebeccarichardsevents@gmail.com"
                    class="text-gray-600 hover:text-rose-400 transition-colors duration-200"
                  >
                    rebeccarichardsevents@gmail.com
                  </a>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <Phone size={24} class="text-rose-400 flex-shrink-0 mt-1" />
                <div>
                  <h4 class="font-light text-gray-900 mb-1">Phone</h4>
                  <a
                    href="tel:+12672591036"
                    class="text-gray-600 hover:text-rose-400 transition-colors duration-200"
                  >
                    (267) 259-1036
                  </a>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <MapPin size={24} class="text-rose-400 flex-shrink-0 mt-1" />
                <div>
                  <h4 class="font-light text-gray-900 mb-1">Service Area</h4>
                  <p class="text-gray-600 font-light">
                    Doylestown, PA & surrounding areas<br />
                    Available for destination weddings
                  </p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <Clock size={24} class="text-rose-400 flex-shrink-0 mt-1" />
                <div>
                  <h4 class="font-light text-gray-900 mb-1">Response Time</h4>
                  <p class="text-gray-600 font-light">
                    Typically within 24 hours<br />
                    Monday - Sunday
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- FAQ -->
          <div class="bg-white rounded-lg shadow-sm p-8">
            <h3 class="text-2xl font-light text-gray-900 mb-6 tracking-wide">
              Frequently Asked Questions
            </h3>

            <div class="space-y-6">
              <div>
                <h4 class="font-light text-gray-900 mb-2">How far in advance should I book?</h4>
                <p class="text-gray-600 font-light text-sm">
                  I recommend booking 8-12 months in advance for weddings, especially for popular
                  dates and seasons.
                </p>
              </div>

              <div>
                <h4 class="font-light text-gray-900 mb-2">Do you travel for weddings?</h4>
                <p class="text-gray-600 font-light text-sm">
                  Yes! I love destination weddings and am available to travel throughout the
                  Mid-Atlantic region and beyond.
                </p>
              </div>

              <div>
                <h4 class="font-light text-gray-900 mb-2">What's included in your packages?</h4>
                <p class="text-gray-600 font-light text-sm">
                  All packages include professional editing, online gallery delivery, and print
                  release. Specific inclusions vary by package.
                </p>
              </div>

              <div>
                <h4 class="font-light text-gray-900 mb-2">Do you offer engagement sessions?</h4>
                <p class="text-gray-600 font-light text-sm">
                  Absolutely! Engagement sessions are a wonderful way to get comfortable with each
                  other before your wedding day.
                </p>
              </div>
            </div>
          </div>
        </ScrollAnimation>
      </div>
    </div>
  </section>

    <!-- Call to Action -->
    <section class="py-20 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <ScrollAnimation client:load animation="fadeIn">
          <h2 class="text-4xl md:text-5xl font-light text-gray-900 mb-8 tracking-wide">
            Ready to Get Started?
          </h2>
          <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-12 font-light">
            I can't wait to learn about your love story and discuss how we can create beautiful memories
            together.
          </p>
        </ScrollAnimation>

        <ScrollAnimation client:load animation="slideUp" delay={0.2}>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/services"
              class="border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-sm hover:border-gray-400 transition-colors duration-200 font-light tracking-wide hover-scale"
            >
              View Packages
            </a>
            <a
              href="/client-albums"
              class="border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-sm hover:border-gray-400 transition-colors duration-200 font-light tracking-wide hover-scale"
            >
              View Client Albums
            </a>
          </div>
        </ScrollAnimation>
      </div>
    </section>
  </PageTransition>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    // Dynamically import confetti to avoid SSR issues
    const { default: confetti } = await import('canvas-confetti')
    const form = document.getElementById('contact-form') as HTMLFormElement | null
    const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null | undefined
    const originalButtonText = submitButton?.innerHTML

    if (!form) {
      console.error('Contact form not found')
      return
    }

    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault()

      // Show loading state
      if (submitButton) {
        submitButton.disabled = true
        submitButton.innerHTML = '<span>Sending...</span>'
      }

      try {
        // Get form data
        const formData = new FormData(form)

        // Submit to Formspree
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        })

        if (response.ok) {
          // Show success message
          showMessage('success', 'Thank you for your message! I\'ll get back to you within 24 hours.')

          // Trigger confetti celebration
          celebrateSuccess()

          form.reset()
        } else {
          const data = await response.json() as { errors?: { message: string }[] }
          if (data.errors) {
            showMessage('error', data.errors.map((error: { message: string }) => error.message).join(', '))
          } else {
            showMessage('error', 'There was a problem sending your message. Please try again.')
          }
        }
      } catch (error) {
        showMessage('error', 'There was a problem sending your message. Please try again or contact me directly.')
      } finally {
        // Reset button state
        if (submitButton && originalButtonText) {
          submitButton.disabled = false
          submitButton.innerHTML = originalButtonText
        }
      }
    })

    function showMessage(type: 'success' | 'error', text: string) {
      if (!form) return

      // Remove any existing messages
      const existingMessage = form.parentElement?.querySelector('.form-message')
      existingMessage?.remove()

      // Create message element
      const messageDiv = document.createElement('div')
      messageDiv.className = `form-message px-4 py-3 rounded-sm mb-6 ${
        type === 'success'
          ? 'bg-green-50 border border-green-200 text-green-800'
          : 'bg-red-50 border border-red-200 text-red-800'
      }`
      messageDiv.innerHTML = `<p class="font-light">${text}</p>`

      // Insert message
      form.parentElement?.insertBefore(messageDiv, form)

      // Remove message after 8 seconds
      setTimeout(() => {
        messageDiv.remove()
      }, 8000)
    }

    function celebrateSuccess() {
      // Create a beautiful confetti animation with rose/pink colors to match the theme
      const duration = 3000
      const animationEnd = Date.now() + duration
      const defaults = {
        startVelocity: 30,
        spread: 360,
        ticks: 60,
        zIndex: 9999,
        colors: ['#fb7185', '#f43f5e', '#e11d48', '#fda4af', '#fecaca'] // Rose/pink theme colors
      }

      function randomInRange(min: number, max: number): number {
        return Math.random() * (max - min) + min
      }

      const interval = setInterval(function() {
        const timeLeft = animationEnd - Date.now()

        if (timeLeft <= 0) {
          return clearInterval(interval)
        }

        const particleCount = 50 * (timeLeft / duration)

        // Left side burst
        confetti({
          ...defaults,
          particleCount,
          origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 }
        })

        // Right side burst
        confetti({
          ...defaults,
          particleCount,
          origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 }
        })
      }, 250)

      // Add a final big burst from the center
      setTimeout(() => {
        confetti({
          ...defaults,
          particleCount: 100,
          spread: 120,
          origin: { y: 0.6 }
        })
      }, 500)
    }
  })
</script>
