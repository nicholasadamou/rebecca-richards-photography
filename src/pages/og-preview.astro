---
import Layout from '../layouts/Layout.astro'

// Only show this page in development
if (import.meta.env.PROD) {
  return Astro.redirect('/404')
}

// Static showcase items - only showing pre-generated images
const staticImages = [
  {
    title: 'Homepage OG Image',
    description: 'Hero-style layout with gradient background',
    filename: 'homepage.png',
    path: '/og/homepage.png'
  },
  {
    title: 'About Page OG Image',
    description: 'Professional layout with heart icon',
    filename: 'about.png',
    path: '/og/about.png'
  },
  {
    title: 'Services Page OG Image',
    description: 'Clean layout showcasing photography services',
    filename: 'services.png',
    path: '/og/services.png'
  },
  {
    title: 'Contact Page OG Image',
    description: 'Elegant contact invitation layout',
    filename: 'contact.png',
    path: '/og/contact.png'
  },
  {
    title: 'Default Album OG Image',
    description: 'Album template with camera icon',
    filename: 'default-album.png',
    path: '/og/default-album.png'
  }
]
---

<Layout 
  title="OG Images Preview - Development Only"
  description="Preview of static Open Graph images"
>
  <div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-12">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center mb-16">
        <div class="inline-flex items-center px-4 py-2 bg-rose-100 text-rose-600 rounded-full text-sm font-light mb-6">
          🎨 Development Only
        </div>
        <h1 class="text-5xl md:text-6xl font-light text-gray-900 mb-6 tracking-wide">
          OG Images Preview
        </h1>
        <p class="text-xl text-gray-600 font-light max-w-3xl mx-auto leading-relaxed">
          Static Open Graph images generated for Rebecca Richards Photography. 
          These images appear when your pages are shared on social media platforms.
        </p>
        
        <!-- Stats -->
        <div class="flex flex-wrap justify-center gap-8 mt-8 text-center">
          <div>
            <div class="text-3xl font-light text-rose-400">{staticImages.length}</div>
            <div class="text-sm text-gray-500 font-light">Static Images</div>
          </div>
          <div>
            <div class="text-3xl font-light text-rose-400">1200×630</div>
            <div class="text-sm text-gray-500 font-light">Dimensions</div>
          </div>
          <div>
            <div class="text-3xl font-light text-rose-400">25-100KB</div>
            <div class="text-sm text-gray-500 font-light">File Size</div>
          </div>
        </div>
      </div>

      <!-- Testing Tools -->
      <div class="bg-white rounded-lg shadow-sm p-6 mb-12 border border-gray-200">
        <h2 class="text-2xl font-light text-gray-900 mb-4 tracking-wide">Social Media Testing Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <a 
            href="https://developers.facebook.com/tools/debug/" 
            target="_blank" 
            class="flex items-center p-3 border border-gray-200 rounded-sm hover:border-rose-300 hover:bg-rose-50 transition-all duration-200 group"
          >
            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </div>
            <span class="text-sm font-light text-gray-700 group-hover:text-rose-600">Facebook Debugger</span>
          </a>
          
          <a 
            href="https://cards-dev.twitter.com/validator" 
            target="_blank"
            class="flex items-center p-3 border border-gray-200 rounded-sm hover:border-rose-300 hover:bg-rose-50 transition-all duration-200 group"
          >
            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            </div>
            <span class="text-sm font-light text-gray-700 group-hover:text-rose-600">Twitter Validator</span>
          </a>
          
          <a 
            href="https://www.linkedin.com/post-inspector/" 
            target="_blank"
            class="flex items-center p-3 border border-gray-200 rounded-sm hover:border-rose-300 hover:bg-rose-50 transition-all duration-200 group"
          >
            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <span class="text-sm font-light text-gray-700 group-hover:text-rose-600">LinkedIn Inspector</span>
          </a>
        </div>
      </div>

      <!-- Images Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
        {staticImages.map((item, index) => (
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-all duration-300 group">
            <!-- Image Preview -->
            <div class="aspect-[1.91/1] bg-gray-100 relative overflow-hidden">
              <img 
                src={item.path}
                alt={`${item.title}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute top-4 right-4 bg-black/60 text-white px-2 py-1 rounded text-xs font-light">
                1200×630
              </div>
            </div>
            
            <!-- Content -->
            <div class="p-6">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-light text-gray-900 tracking-wide">
                  {item.title}
                </h3>
                <span class="px-2 py-1 bg-rose-100 text-rose-600 text-xs font-light rounded">
                  static
                </span>
              </div>
              
              <p class="text-gray-600 font-light mb-4 leading-relaxed">
                {item.description}
              </p>
              
              <!-- Meta Info -->
              <div class="space-y-2 text-sm">
                <div class="flex items-center text-gray-500">
                  <span class="font-medium mr-2">File:</span>
                  <span class="font-light font-mono">{item.filename}</span>
                </div>
                <div class="flex items-center text-gray-500">
                  <span class="font-medium mr-2">Path:</span>
                  <span class="font-light font-mono">{item.path}</span>
                </div>
              </div>
              
              <!-- Actions -->
              <div class="flex items-center gap-3 mt-4 pt-4 border-t border-gray-100">
                <a 
                  href={item.path}
                  target="_blank"
                  class="flex items-center text-rose-400 hover:text-rose-500 text-sm font-light transition-colors duration-200"
                >
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                  View Full Size
                </a>
                <button 
                  class="copy-btn flex items-center text-gray-500 hover:text-gray-700 text-sm font-light transition-colors duration-200"
                  data-copy={item.path}
                >
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                  </svg>
                  Copy Path
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Usage Instructions -->
      <div class="bg-gray-900 text-white rounded-lg p-8 mb-12">
        <h2 class="text-2xl font-light mb-6 tracking-wide">Usage Instructions</h2>
        <div class="space-y-4 text-gray-300 font-light">
          <p>
            <strong class="text-white">Static Images:</strong> These images are pre-generated during build and served directly from <code class="text-rose-300">/public/og/</code>
          </p>
          <p>
            <strong class="text-white">Dynamic Images:</strong> For album pages and custom content, use the API endpoint: <code class="text-rose-300">/api/og</code>
          </p>
          <p>
            <strong class="text-white">Testing:</strong> Use the social media tools above to test how these images appear when shared.
          </p>
        </div>
      </div>

      <!-- Footer -->
      <div class="text-center text-gray-500 font-light">
        <p>This page is only visible in development mode.</p>
        <p class="text-sm mt-2">Static OG images are automatically generated during the build process.</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Simple copy to clipboard functionality
  document.addEventListener('click', async (e) => {
    if (e.target.closest('.copy-btn')) {
      const button = e.target.closest('button')
      const textToCopy = button.dataset.copy
      
      try {
        await navigator.clipboard.writeText(textToCopy)
        const originalText = button.innerHTML
        button.innerHTML = button.innerHTML.replace('Copy Path', 'Copied!')
        button.classList.add('text-green-500')
        
        setTimeout(() => {
          button.innerHTML = originalText
          button.classList.remove('text-green-500')
        }, 2000)
      } catch (err) {
        console.error('Failed to copy:', err)
      }
    }
  })
</script>