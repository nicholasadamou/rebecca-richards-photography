---
import { Instagram, Mail, Phone, MapPin } from 'lucide-astro'
---

<footer class="bg-gray-50 border-t border-gray-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand & Description -->
      <div class="col-span-1">
        <h3 class="text-2xl font-light tracking-wide text-gray-900 mb-4">
          Rebecca Richards Photography
        </h3>
        <p class="text-gray-600 font-light leading-relaxed mb-6">
          Capturing authentic, timeless moments for weddings and special events in Doylestown, PA
          and beyond.
        </p>
        <div class="flex space-x-4">
          <a
            href="https://instagram.com/rebeccarichardsphotography_"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-rose-400 transition-colors duration-200"
            aria-label="Follow on Instagram"
          >
            <Instagram size={24} />
          </a>
        </div>
      </div>

      <!-- Contact Information -->
      <div class="col-span-1">
        <h4 class="text-lg font-light tracking-wide text-gray-900 mb-4">Contact</h4>
        <div class="space-y-3">
          <div class="flex items-center space-x-3">
            <Mail size={18} class="text-rose-400 flex-shrink-0" />
            <a
              href="mailto:rebeccarichardsevents@gmail.com"
              class="text-gray-600 hover:text-gray-900 transition-colors duration-200"
            >
              rebeccarichardsevents@gmail.com
            </a>
          </div>
          <div class="flex items-center space-x-3">
            <Phone size={18} class="text-rose-400 flex-shrink-0" />
            <a
              href="tel:+12672591036"
              class="text-gray-600 hover:text-gray-900 transition-colors duration-200"
            >
              (267) 259-1036
            </a>
          </div>
          <div class="flex items-center space-x-3">
            <MapPin size={18} class="text-rose-400 flex-shrink-0" />
            <span class="text-gray-600"> Doylestown, PA </span>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="col-span-1">
        <h4 class="text-lg font-light tracking-wide text-gray-900 mb-4">Quick Links</h4>
        <div class="space-y-2">
          <a
            href="/client-albums"
            class="block text-gray-600 hover:text-gray-900 transition-colors duration-200"
          >
            Client Albums
          </a>
          <a
            href="/about"
            class="block text-gray-600 hover:text-gray-900 transition-colors duration-200"
          >
            About Rebecca
          </a>
          <a
            href="/services"
            class="block text-gray-600 hover:text-gray-900 transition-colors duration-200"
          >
            Services & Pricing
          </a>
          <a
            href="/contact"
            class="block text-gray-600 hover:text-gray-900 transition-colors duration-200"
          >
            Book a Consultation
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-8 pt-8 border-t border-gray-200 text-center">
      <p class="text-gray-500 font-light">
        © {new Date().getFullYear()} Rebecca Richards Photography. All rights reserved.
      </p>
    </div>
  </div>
</footer>
