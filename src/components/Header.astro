---
import { Menu, X } from 'lucide-astro'
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100">
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center py-4 md:py-6">
      <!-- Logo/Brand -->
      <a href="/" class="flex-shrink-0">
        <h1 class="text-2xl md:text-3xl font-light tracking-wide text-gray-900">
          Rebecca Richards
          <span class="block text-sm md:text-base font-light text-gray-600 mt-0">
            Photography
          </span>
        </h1>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a
          href="/"
          class="text-gray-700 hover:text-gray-900 transition-colors duration-200 font-light tracking-wide"
        >
          Home
        </a>
        <a
          href="/client-albums"
          class="text-gray-700 hover:text-gray-900 transition-colors duration-200 font-light tracking-wide"
        >
          Client Albums
        </a>
        <a
          href="/about"
          class="text-gray-700 hover:text-gray-900 transition-colors duration-200 font-light tracking-wide"
        >
          About
        </a>
        <a
          href="/services"
          class="text-gray-700 hover:text-gray-900 transition-colors duration-200 font-light tracking-wide"
        >
          Services
        </a>
        <a
          href="/contact"
          class="bg-rose-400 hover:bg-rose-500 text-white px-6 py-2 rounded-sm transition-colors duration-200 font-light tracking-wide"
        >
          Contact
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        class="md:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-rose-400"
        id="mobile-menu-toggle"
        aria-label="Toggle menu"
      >
        <Menu size={24} class="menu-icon" />
        <X size={24} class="close-icon hidden" />
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div class="md:hidden hidden" id="mobile-menu">
      <div class="px-2 pt-2 pb-6 space-y-1 bg-white border-t border-gray-100">
        <a
          href="/"
          class="block px-3 py-3 text-gray-700 hover:text-gray-900 transition-colors duration-200 font-light tracking-wide"
        >
          Home
        </a>
        <a
          href="/client-albums"
          class="block px-3 py-3 text-gray-700 hover:text-gray-900 transition-colors duration-200 font-light tracking-wide"
        >
          Client Albums
        </a>
        <a
          href="/about"
          class="block px-3 py-3 text-gray-700 hover:text-gray-900 transition-colors duration-200 font-light tracking-wide"
        >
          About
        </a>
        <a
          href="/services"
          class="block px-3 py-3 text-gray-700 hover:text-gray-900 transition-colors duration-200 font-light tracking-wide"
        >
          Services
        </a>
        <a
          href="/contact"
          class="block mx-3 mt-4 bg-rose-400 hover:bg-rose-500 text-white px-6 py-3 rounded-sm transition-colors duration-200 font-light tracking-wide text-center"
        >
          Contact
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButton = document.getElementById('mobile-menu-toggle')
    const mobileMenu = document.getElementById('mobile-menu')
    const menuIcon = toggleButton?.querySelector('.menu-icon')
    const closeIcon = toggleButton?.querySelector('.close-icon')

    toggleButton?.addEventListener('click', () => {
      const isHidden = mobileMenu?.classList.contains('hidden')

      if (isHidden) {
        mobileMenu?.classList.remove('hidden')
        menuIcon?.classList.add('hidden')
        closeIcon?.classList.remove('hidden')
      } else {
        mobileMenu?.classList.add('hidden')
        menuIcon?.classList.remove('hidden')
        closeIcon?.classList.add('hidden')
      }
    })
  })
</script>
