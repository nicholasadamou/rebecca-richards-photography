---
import { ChevronRight, Home } from 'lucide-astro'

export interface BreadcrumbItem {
  name: string
  url: string
  current?: boolean
}

export interface Props {
  items: BreadcrumbItem[]
  className?: string
}

const { items, className = '' } = Astro.props
---

<nav aria-label="Breadcrumb" class={`breadcrumb-nav ${className}`}>
  <ol class="flex items-center space-x-2 text-sm text-gray-600">
    <!-- Home breadcrumb -->
    <li class="flex items-center">
      <a 
        href="/" 
        class="flex items-center hover:text-rose-400 transition-colors duration-200"
        aria-label="Home"
      >
        <Home size={16} class="mr-1" />
        <span class="sr-only">Home</span>
      </a>
    </li>

    <!-- Dynamic breadcrumb items -->
    {items.map((item, index) => (
      <li class="flex items-center">
        <ChevronRight size={16} class="text-gray-400 mx-2" aria-hidden="true" />
        
        {item.current ? (
          <span 
            class="text-gray-900 font-medium" 
            aria-current="page"
          >
            {item.name}
          </span>
        ) : (
          <a 
            href={item.url} 
            class="hover:text-rose-400 transition-colors duration-200"
          >
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb-nav {
    padding: 1rem 0;
    border-bottom: 1px solid rgb(243 244 246);
  }

  @media (max-width: 640px) {
    .breadcrumb-nav ol {
      font-size: 0.875rem;
    }
    
    .breadcrumb-nav .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>