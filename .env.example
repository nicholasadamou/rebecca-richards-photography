# Sanity Configuration
# Get these values from your Sanity project dashboard at https://sanity.io/manage

# Public Sanity Project ID (can be exposed to client)
PUBLIC_SANITY_PROJECT_ID=gwf79bj6

# Public Sanity Dataset (usually 'production' or 'development')
PUBLIC_SANITY_DATASET=production

# Optional Docker Compose host ports (container ports stay fixed)
SITE_PORT=4321
STUDIO_PORT=3333

# Sanity API Token (keep this private - only needed for mutations/writes)
# Create a token with Editor permissions in your Sanity project dashboard
# This is optional for read-only operations in production
# SANITY_API_TOKEN=your_sanity_api_token_here

# Docker Compose maps the public project/dataset above to both the site and
# Studio. Studio uses browser sign-in; no Studio API token is needed.
# Content remains hosted by Sanity. Select an existing development dataset
# above if local editing should not affect the production dataset.

# Instructions:
# 1. Copy this file to `.env` in your project root
# 2. Replace the values above with your actual Sanity project details
# 3. Add `.env` to your .gitignore file to keep your tokens secure
# 4. For production deployment, set these environment variables in your hosting platform
